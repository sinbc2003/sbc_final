      "type": "column_mapping",
      "params": { "mapping_rules": "" },
      "position": { "x": 660, "y": 200 }
    },
    {
      "id": "save",
      "type": "save_xlsx",
      "params": { "output_name": "정리된_명단" },
      "position": { "x": 940, "y": 200 }
    }
  ],
  "edges": [
    { "from": "roster_file", "from_port": "파일", "to": "read_xlsx", "to_port": "파일" },
